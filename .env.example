# Crop Health Forecasting Platform - Environment Variables
# Copy this file to .env and update values for your environment

# Database
DATABASE_URL=postgresql://cropai:cropai_secret@localhost:5432/crop_health
POSTGRES_USER=cropai
POSTGRES_PASSWORD=cropai_secret
POSTGRES_DB=crop_health

# JWT Authentication
SECRET_KEY=change-this-to-a-long-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000"]

# File Paths
MODELS_DIR=./models
UPLOAD_DIR=./uploads

# Frontend
REACT_APP_API_URL=http://localhost:8000/api/v1

# Backend Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Logging
LOG_LEVEL=INFO
